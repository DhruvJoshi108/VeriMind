# Environment and authentication. Set a long random API_KEY before production.
ENVIRONMENT=development
API_KEY=replace-with-a-long-random-secret
# Comma-separated deployed frontend origins, never * in production.
CORS_ORIGINS=

# Broad web search: set SEARCH_BACKEND=tavily and add a Tavily key below.
# Keyless Wikipedia-only search is available with SEARCH_BACKEND=wikipedia.
SEARCH_BACKEND=null
SEARCH_API_KEY=

# Evidence judge: create a key at https://console.groq.com/
JUDGE_BACKEND=local
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
REQUEST_TIMEOUT_SECONDS=20

# Optional pretrained local NLI model. Downloads weights on first use.
# Install the optional transformer dependencies before enabling it.
# NLI_BACKEND=transformer
# NLI_MODEL_NAME=MoritzLaurer/DeBERTa-v3-base-mnli
# NLI_DEVICE=auto

# Limits and persistence.
DATABASE_URL=
MAX_CLAIMS_PER_DOC=50
MAX_EVIDENCE_PER_CLAIM=5
RISK_THRESHOLD=60.0
VERIMIND_DASHBOARD_TIMEOUT_SECONDS=90
VERIMIND_DASHBOARD_BATCH_LIMIT=50
VERIMIND_EVAL_RESULTS_DIR=eval/results
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Optional Redis URL for a future shared rate-limit deployment.
REDIS_URL=
LOG_LEVEL=INFO
