FROM python:3.11-slim

WORKDIR /app
COPY requirements-api-deploy.txt ./requirements-api-deploy.txt
RUN pip install --no-cache-dir -r requirements-api-deploy.txt \
    && useradd --create-home --uid 10001 verimind
COPY api ./api
COPY verimind ./verimind
COPY artifacts/nli_model.pkl ./artifacts/nli_model.pkl
RUN mkdir -p /app/data && chown -R verimind:verimind /app
USER verimind
ENV PYTHONPATH=/app
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
